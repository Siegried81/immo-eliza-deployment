# Copy to .env and fill in. .env is gitignored; NEVER put real keys in this example.
#
# Who reads it: `docker compose` (for ${...} in docker-compose.yml) and
# `docker run --env-file .env`. The Python code does not load .env itself, so
# for a manual `streamlit run` / `uvicorn`, export the variables in the shell.
# Every variable is optional; the defaults are shown.

# --- docker compose ------------------------------------------------------------
# Docker Hub namespace of the image tags (docker-compose.yml).
# DOCKERHUB_USERNAME=siegried

# --- UI (streamlit/app.py) -----------------------------------------------------
# Where the API answers. Compose sets http://api:8000 itself.
# API_URL=http://localhost:8000
# The "API documentation" link; defaults to $API_URL/docs, empty hides it.
# API_DOCS_URL=

# --- API (api/app.py, monitoring/monitor.py) ---------------------------------
# Where each prediction is appended (JSON Lines).
# PREDICTION_LOG_PATH=monitoring/logs.jsonl

# --- Both images ---------------------------------------------------------------
# Listening port; Render sets it. API defaults to 8000, UI image to 10000.
# PORT=

# Not here: the Hugging Face write token used by scripts/publish_hf.py. It is
# stored by `hf auth login` in the Hugging Face cache, outside the repository.
# The Docker Hub token is a GitHub Actions secret (DOCKERHUB_TOKEN).
